// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Goal {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String
  status      String   @default("ACTIVE")
  targetDate  DateTime?
  createdAt   DateTime @default(now())
}