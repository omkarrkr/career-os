// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Goal {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  category    String
  status      String   @default("ACTIVE")
  targetDate  DateTime?
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  priority    String   @default("MEDIUM") @db.VarChar(6)
  subtasks    Subtask[]

  @@index([userId])
}

model Subtask {
  id          Int      @id @default(autoincrement())
  goalId      Int
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title       String   @db.VarChar(200)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([goalId, id])
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  goals        Goal[]
  sessions     AuthSession[]
  careerProfile CareerProfile?
  skills       UserSkill[]
  projects     Project[]
}

model Skill {
  id        Int         @id @default(autoincrement())
  slug      String      @unique @db.VarChar(80)
  name      String      @db.VarChar(80)
  category  String      @db.VarChar(80)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  users     UserSkill[]
  projects  ProjectSkill[]
}

model Project {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(3000)
  outcome     String?  @db.VarChar(2000)
  status      String   @default("PLANNED") @db.VarChar(12)
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  repositoryUrl String? @db.VarChar(2048)
  demoUrl     String?  @db.VarChar(2048)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skills      ProjectSkill[]

  @@index([userId, id])
}

model ProjectSkill {
  projectId Int
  skillId   Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  evidence  String? @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([projectId, skillId])
  @@index([skillId])
}

model UserSkill {
  userId    Int
  skillId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  level     String   @default("BEGINNER") @db.VarChar(12)
  notes     String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, skillId])
  @@index([skillId])
}

model CareerProfile {
  userId              Int       @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  institution         String?   @db.VarChar(200)
  degree              String?   @db.VarChar(100)
  graduationYear      Int?
  targetRole          String?   @db.VarChar(100)
  weeklyLearningHours Int?
  interests           String[]  @default([])
  bio                 String?   @db.VarChar(1000)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tokenHash String      @unique
  createdAt DateTime    @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([sessionId])
}
