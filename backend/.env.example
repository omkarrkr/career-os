# Template only. Keep your real backend/.env private and preserve it if present.
# Copy the connection string from your own Supabase project's Connect settings.
# Replace this entire placeholder locally; never paste credentials into chat.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/postgres"
# Optional HTTP port, from 1 to 65535. Defaults to 3000 if absent.
PORT=3000
# development (default), test, or production. Production expects HTTPS hosting.
NODE_ENV=development
# Exact browser origins, separated by commas; no paths, trailing slash or wildcard.
# If absent/empty, no explicit browser origins are allowed. No-Origin API calls work.
CORS_ORIGINS=http://localhost:5173
