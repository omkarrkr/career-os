{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup-env.mjs --import tsx --test tests/*.test.mjs",
    "test:integration:registration": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/registration.test.mjs",
    "test:integration:auth": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/auth.test.mjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:status": "prisma migrate status --config prisma7.config.ts",
    "prisma:validate:auth-proposal": "prisma validate --config prisma7.config.ts --schema prisma/proposals/auth/schema.prisma",
    "test:migration:auth": "node --import tsx --test tests/auth-migration.test.mjs",
    "test:integration:goals": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/goals.test.mjs",
    "test:integration:password": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/password-change.test.mjs",
    "test:integration:profile": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/career-profile.test.mjs",
    "test:browser-server": "node --import ./tests/setup-env.mjs --import tsx tests/fixtures/browser-server.mjs",
    "test:integration:dashboard": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/dashboard.test.mjs",
    "test:integration:subtasks": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/subtasks.test.mjs",
    "test:integration:skills": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/skills.test.mjs",
    "test:integration:projects": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/projects.test.mjs",
    "test:integration:career-records": "node --import ./tests/setup-env.mjs --import tsx --test tests/integration/career-records.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csrf-csrf": "4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
